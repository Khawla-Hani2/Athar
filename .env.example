# انسخي هذا الملف إلى .env واملئي القيم من إعدادات مشروع Firebase الخاص بك
# Firebase Console → Project Settings → General → Your apps → SDK setup and configuration

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# للتطوير المحلي عبر Firebase Emulator Suite فقط (بدون مشروع حقيقي):
# انسخي هذا السطر إلى .env.local وشغّلي: firebase emulators:start --only auth,firestore
# مشروع الإيميوليتور الافتراضي هو demo-athar (مطابق لـ .firebaserc) — لا تغيّريه هنا
# بدون تغييره أيضًا هناك، وإلا ستظهر تحذيرات عدم تطابق معرّف المشروع.
# VITE_USE_FIREBASE_EMULATOR=true
